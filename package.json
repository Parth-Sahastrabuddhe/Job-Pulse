{
  "name": "job-alert-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <26"
  },
  "scripts": {
    "start": "node src/index.js",
    "run-once": "node src/index.js",
    "watch": "node src/index.js --watch",
    "dry-run": "node src/index.js --dry-run --notify-existing",
    "seed": "node src/index.js --seed-only",
    "seed:sponsors": "node src/h1b-sponsors-seed.js",
    "tailor": "node src/tailor.js",
    "check": "find src scripts -name '*.js' -o -name '*.mjs' | sort | xargs -n1 node --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "core": "node src/core-cli.js",
    "open-core:check": "node scripts/export-open-core.mjs --check",
    "open-core:export": "node scripts/export-open-core.mjs",
    "multi-user": "node src/multi-user.js",
    "db:maintenance": "node scripts/db-maintenance.js",
    "delivery:claims": "node scripts/personal-delivery-claims.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "discord.js": "^14.27.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "vitest": "^4.1.2"
  }
}
